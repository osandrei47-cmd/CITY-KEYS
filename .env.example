DATABASE_URL=postgresql://user:password@host:5432/database_name
PAYLOAD_SECRET=replace-with-a-long-random-string

# SMTP для уведомлений о новых заявках (Leads) на lid@city-keys.ru
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=lid@city-keys.ru
SMTP_PASS=replace-with-mailbox-password
SMTP_FROM=lid@city-keys.ru
LEAD_NOTIFICATION_EMAIL=lid@city-keys.ru

# Яндекс.Карты JS API — используется на /kontakty (карта с меткой офиса)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=replace-with-yandex-maps-api-key
