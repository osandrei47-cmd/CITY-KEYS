DATABASE_URL=postgresql://user:password@host:5432/database_name
PAYLOAD_SECRET=replace-with-a-long-random-string

# Ключ шифрования Server Actions (App Router). Если не задан, Next.js на
# каждом next build генерирует новый случайный AES-ключ и кладёт его в
# .rscinfo внутри .next/cache — а в контейнере на Timeweb этот кэш не
# персистентный/без прав на запись, поэтому при каждом рестарте (который на
# Timeweb пересобирает приложение заново) получается новый ключ. Любая уже
# открытая вкладка админки после такого рестарта падает с
# "Failed to find Server Action ... older or newer deployment", даже если
# исходный код (коммит) не менялся. Сгенерировать: node -e
# "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Задать один раз и не менять — то же значение должно быть одинаковым во
# всех переменных окружения на Timeweb (build и runtime).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Полноэкранная заглушка «сайт на реконструкции» (см. src/middleware.ts).
# При true все запросы, кроме /maintenance, /preview-ck2026, /staff-x7k2/*,
# /api/*, /feed/* и статики, редиректятся на /maintenance.
MAINTENANCE_MODE=false

# SMTP для уведомлений о новых заявках (Leads) на lid@city-keys.ru
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=lid@city-keys.ru
SMTP_PASS=replace-with-mailbox-password
SMTP_FROM=lid@city-keys.ru
LEAD_NOTIFICATION_EMAIL=lid@city-keys.ru

# Яндекс.Карты JS API — используется на /kontakty (карта с меткой офиса)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=replace-with-yandex-maps-api-key

# Timeweb Object Storage (S3-совместимое) — хранение медиафайлов Payload
# (см. src/payload.config.ts, плагин @payloadcms/storage-s3). Без этих
# переменных загрузка файлов в админке будет падать.
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=city-keys-media
S3_REGION=ru-1
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
